# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/dist_test
/release

# electron-builder output
/release/

# misc
.DS_Store
Thumbs.db

# debug / log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# local env files — never commit secrets
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js cache
.cache/

# license activation — machine-specific, must not be shared
license.dat
*.lic

# license system — private keys and key generation scripts
scripts/private_key.pem
scripts/public_key.pem
scripts/keygen.js
scripts/generate-keys.js
src/lib/public_key.pem
src/lib/license.ts
src/app/license/

# AI / tool session data
.claude/
.codex
.playwright-mcp/
.gemini/


# temp / scratch files
issue_body.txt
conductor/
